+  left: 0;
+  right: 0;
+  bottom: 1px;
+  height: 2px;
+  border-radius: 999px;
+  background: var(--brand);
+}
+
+.public-register-link.active {
+  box-shadow: 0 0 0 1px var(--brand), 0 4px 18px rgba(20, 20, 19, 0.08);
+}
