+
+  .auth-editorial-layout,
+  .auth-editorial-layout-register {
+    gap: 38px;
+  }
+
+  .auth-story {
+    padding: 0;
+  }
+
+  .auth-story-step {
+    margin-bottom: 30px;
+    font-size: 24px;
+  }
+
+  .auth-story-eyebrow {
+    margin-bottom: 12px;
+    font-size: 13px;
+  }
+
+  .auth-story-title {
+    margin-bottom: 18px;
+    font-size: clamp(34px, 10vw, 44px);
+  }
+
+  .auth-story-description {
+    font-size: 15px;
+    line-height: 1.72;
+  }
+
+  .auth-story-quote {
+    margin: 30px 0 34px;
+    padding-left: 16px;
+    font-size: 16px;
+  }
+
+  .auth-story-features {
+    grid-template-columns: 1fr;
+  }
+
+  .auth-story-feature,
+  .auth-story-feature:first-child,
+  .auth-story-feature:last-child {
+    display: grid;
+    grid-template-columns: 42px minmax(0, 1fr);
+    align-items: center;
+    gap: 14px;
+    padding: 14px 0;
+    text-align: left;
+  }
+
+  .auth-story-feature + .auth-story-feature {
+    border-left: 0;
+    border-top: 1px solid var(--border);
+  }
+
+  .auth-story-icon {
+    width: 34px;
+    height: 34px;
+    margin: 0;
+  }
+
+  .auth-story-feature h3 {
+    margin-bottom: 3px;
+    font-size: 15px;
+  }
+
+  .auth-card.auth-editorial-card {
+    padding: 26px 18px;
+    border-radius: 12px;
+  }
+
+  .auth-card.auth-editorial-card h1 {
+    font-size: 34px;
+  }
+
+  .auth-register-grid {
+    grid-template-columns: 1fr;
+    gap: 18px;
+  }
+
+  .auth-card.auth-editorial-card input {
+    min-height: 50px;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .auth-card.auth-editorial-card input,
+  .auth-outline-action {
+    transition: none;
+  }
+}
