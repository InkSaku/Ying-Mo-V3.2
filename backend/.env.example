APP_ENV=development
DATABASE_URL=sqlite+pysqlite:///yingmo_dev.db
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

SECRET_KEY=replace-with-a-strong-secret-at-least-32-bytes
JWT_SECRET_KEY=replace-with-a-different-strong-secret-at-least-32-bytes
REGISTRATION_INVITE_CODE=replace-with-your-invite-code

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATELIMIT_STORAGE_URI=memory://
RATE_LIMIT_REGISTER=5 per hour
RATE_LIMIT_LOGIN=10 per minute
RATE_LIMIT_REFRESH=30 per minute
RATE_LIMIT_COMMENT=30 per minute
RATE_LIMIT_UPLOAD=20 per hour
RATE_LIMIT_API=300 per minute
RATE_LIMIT_EMAIL_VERIFICATION=5 per hour
RATE_LIMIT_EMAIL_CONFIRM=30 per hour
RATE_LIMIT_PASSWORD_RESET=5 per hour
RATE_LIMIT_PASSWORD_RESET_CONFIRM=10 per hour

UPLOAD_ROOT=./uploads
IMAGE_MAX_BYTES=15728640
MAX_CONTENT_LENGTH=33554432
MEDIA_STORAGE_BACKEND=local

# Production S3-compatible private object storage (required when backend=s3)
S3_BUCKET=
S3_PREFIX=yingmo-media
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

SITE_URL=http://localhost:5173
TRUST_PROXY_COUNT=0

# Account email delivery. Console is a redacted development sink and never
# prints recipients, links or tokens; use a local SMTP catcher for manual flows.
# Tests use memory. Production requires smtp, TLS, MAIL_FROM and SMTP_HOST.
MAIL_BACKEND=console
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
ACCOUNT_TOKEN_REQUEST_COOLDOWN_SECONDS=60
